{
  "name": "mizanova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "sql-supersessions": "node scripts/sql-supersessions.mjs",
    "lint": "eslint .",
    "server": "node --env-file=.env.local server/index.js",
    "apply-db": "node scripts/apply-db.mjs",
    "anonymisation-check": "node scripts/anonymisation-check.mjs",
    "bundle-secret-check": "node scripts/bundle-secret-check.mjs",
    "security-check": "node scripts/security-check.mjs && node scripts/anonymisation-check.mjs && node scripts/bundle-secret-check.mjs && node scripts/contrast-check.mjs",
    "preview": "vite preview",
    "contrast-check": "node scripts/contrast-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook-check": "node --env-file=.env.local scripts/webhook-check.mjs",
    "storage-check": "node scripts/storage-check.mjs",
    "mail-check": "node scripts/mail-check.mjs",
    "purge": "node scripts/purge.mjs",
    "backup": "node scripts/backup.mjs",
    "start": "node server/index.js",
    "build:server": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "stripe": "^22.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
